//////////////////////////////////////////////////
// LEARNING OBJECTIVES
//////////////////////////////////////////////////

// By the end of this file you will know:
//
// • How to design custom envelope shapes
// • How envelope curves work
// • How EnvGen can control parameters
//   besides amplitude
// • How to retrigger envelopes
// • How to use envelopes for modulation
// • How to create multichannel envelopes

//////////////////////////////////////////////////
// REVIEW
//////////////////////////////////////////////////

// An envelope consists of:
//
// Levels
//
// and
//
// Times

//////////////////////////////////////////////////
// LEVELS
//////////////////////////////////////////////////

// Values the envelope visits.

//////////////////////////////////////////////////
// TIMES
//////////////////////////////////////////////////

// How long it takes to move
// between levels.

//////////////////////////////////////////////////
// SIMPLE EXAMPLE
//////////////////////////////////////////////////

(
e = Env.new(
    [0, 1, 0],
    [2, 4],
    \lin
);

e.plot;
)

//////////////////////////////////////////////////
// READING THE ENVELOPE
//////////////////////////////////////////////////

// Start at 0
//
// Reach 1 in 2 seconds
//
// Reach 0 in 4 seconds

//////////////////////////////////////////////////
// CUSTOM SHAPES
//////////////////////////////////////////////////

(
e = Env.new(

    [0, 1, 0.5, 0.5, 1, 0.1, 1, 0],

    [1, 0.5, 1, 2, 0.4, 3, 1],

    \lin

);

e.plot;
)

//////////////////////////////////////////////////
// DISCUSSION
//////////////////////////////////////////////////

// How many levels?
//
// How many time segments?
//
// Why?

//////////////////////////////////////////////////
// RULE
//////////////////////////////////////////////////

// Number of times
//
// =
//
// Number of levels - 1

//////////////////////////////////////////////////
// CURVES
//////////////////////////////////////////////////

// Curves define HOW a segment moves
// between two levels.

//////////////////////////////////////////////////
// LINEAR
//////////////////////////////////////////////////

(
Env.new(
    [0, 1, 0],
    [2, 4],
    [0, 0]
).plot;
)

//////////////////////////////////////////////////
// POSITIVE CURVE
//////////////////////////////////////////////////

(
Env.new(
    [0, 1, 0],
    [2, 4],
    [4, 4]
).plot;
)

//////////////////////////////////////////////////
// NEGATIVE CURVE
//////////////////////////////////////////////////

(
Env.new(
    [0, 1, 0],
    [2, 4],
    [-4, -4]
).plot;
)

//////////////////////////////////////////////////
// EXPERIMENT
//////////////////////////////////////////////////

// Compare:
//
// 0
// 4
// -4
// 8
// -8

//////////////////////////////////////////////////
// MULTI-STAGE EXAMPLE
//////////////////////////////////////////////////

(
Env.new(

    [0, 1, 0.5, 0.2, 0.5, 0],

    [0.75, 0.1, 3, 0.1, 4],

    \lin

).plot;
)

//////////////////////////////////////////////////
// ENVGEN AS AMPLITUDE
//////////////////////////////////////////////////

(
{
    var env;

    env = Env(
        [0, 1, 0.5, 1, 0],
        [0.01, 0.5, 0.02, 0.5]
    );

    SinOsc.ar(470)
    *
    EnvGen.kr(
        env,
        doneAction:2
    )
    *
    0.2;

}.play;
)
//////////////////////////////////////////////////
// IMPORTANT
//////////////////////////////////////////////////

// Env describes a shape.
//
// EnvGen performs the shape.

//////////////////////////////////////////////////
// ENVELOPES AS MODULATION
//////////////////////////////////////////////////

// An envelope can control
// almost any parameter.

//////////////////////////////////////////////////
// FREQUENCY ENVELOPE
//////////////////////////////////////////////////

(
{
    var freq;

    freq = EnvGen.kr(

        Env(

            [261, 120, 51],

            [0.035, 0.08],

            \exp

        )

    );

    SinOsc.ar(freq)
    * 0.15;

}.play;
)

//////////////////////////////////////////////////
// LISTEN
//////////////////////////////////////////////////

// Does it sound:
//
// rising?
//
// falling?
//
// percussive?

//////////////////////////////////////////////////
// AMPLITUDE + MODULATION
//////////////////////////////////////////////////

(
{
    var env;
    var gate;
    var gen;

    env = Env(

        [0, 1, 0.5, 0.8, 0, 1.2, 0],

        [0.01, 0.5, 0.02, 0.5, 0.2, 0.5]

    );

    gate = Impulse.kr(
        MouseX.kr(
            0.2,
            3
        )
    );

    gen = EnvGen.kr(
        env,
        gate
    );

    SinOsc.ar(
        270,
        SinOsc.ar(
            gen * 73
        )
    )
    * gen
    * 0.2;

}.play;
)

//////////////////////////////////////////////////
// OBSERVE
//////////////////////////////////////////////////

// Move the mouse.
//
// The retrigger speed changes.

//////////////////////////////////////////////////
// AUTOMATIC RETRIGGERING
//////////////////////////////////////////////////

// Impulse.kr creates triggers.
//
// Every trigger restarts
// the envelope.

//////////////////////////////////////////////////
// MULTICHANNEL ENVELOPES
//////////////////////////////////////////////////

// EnvGen can generate
// several envelopes at once.

//////////////////////////////////////////////////
// EXAMPLE
//////////////////////////////////////////////////

(
{
    SinOsc.ar(

        EnvGen.kr(

            Env.circle(

                [
                    0,
                    1,
                    0,
                    (2..4),
                    0,
                    LFNoise1.kr(
                        0.1 ! 5
                    ) * 10,
                    0
                ],

                [0.01, 0.6]

            )

        )

        * 240

        + 300

    ).sum

    * 0.2;

}.play;
)

//////////////////////////////////////////////////
// WHAT IS HAPPENING?
//////////////////////////////////////////////////

// Multiple envelope outputs
// are being used simultaneously.
//
// These values control
// oscillator frequencies.

//////////////////////////////////////////////////
// ADVANCED IDEA
//////////////////////////////////////////////////

// Envelopes are not only
// volume controls.
//
// They are general-purpose
// control signals.

//////////////////////////////////////////////////
// TRY CONTROLLING
//////////////////////////////////////////////////

// • pitch
// • filter cutoff
// • panning
// • modulation depth
// • delay time

