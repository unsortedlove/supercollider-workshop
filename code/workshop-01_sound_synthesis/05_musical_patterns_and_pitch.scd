//////////////////////////////////////////////////
// LEARNING OBJECTIVES
//////////////////////////////////////////////////

// By the end of this lesson
// you will know:
//
// • How to build a SynthDef
//   for musical notes
//
// • How Scale and Degree work
//
// • How to create melodies
//
// • How to create chords
//
// • How to create arpeggios
//
// • What legato does
//
// • What strum does

//////////////////////////////////////////////////
// A SIMPLE MUSICAL SYNTH
//////////////////////////////////////////////////

(
SynthDef(\sineSimple, {

    arg freq=440, amp=0.2, sustain=1;

    var env;
    var sig;

    env = EnvGen.kr(

        Env.perc(
            0.01,
            sustain,
            1,
            -4
        ),

        doneAction:2

    );

    sig =
    SinOsc.ar(freq)
    * env
    * amp;

    Out.ar(
        0,
        sig ! 2
    );

}).add;
)

//////////////////////////////////////////////////
// IMPORTANT
//////////////////////////////////////////////////

// Pbind can generate pitches
// automatically using:
//
// Scale
//
// and
//
// Degree

//////////////////////////////////////////////////
// SCALE
//////////////////////////////////////////////////

// A scale defines
// available notes.

Scale.major;

Scale.minor;

//////////////////////////////////////////////////
// DEGREE
//////////////////////////////////////////////////

// Degree represents a position
// inside the scale.

//////////////////////////////////////////////////
// MAJOR SCALE
//////////////////////////////////////////////////

// Degree:
//
// 0 1 2 3 4 5 6 7
//
// produces:
//
//  Do Re Mi Fa Sol La Si Do

//////////////////////////////////////////////////
// FIRST MELODY
//////////////////////////////////////////////////

(
Pbind(

    \instrument,\sineSimple,

    \scale,Scale.major,

    \degree,
    Pseq(
        [0,1,2,3,4,5,6,7],
        inf
    ),

    \octave,5,

    \dur,0.25

).play;
)

//////////////////////////////////////////////////
// LISTEN
//////////////////////////////////////////////////

// Ascending?
//
// Descending?
//
// Repeating?

//////////////////////////////////////////////////
// TRY YOUR OWN SCALE
//////////////////////////////////////////////////

(
Pbind(

    \instrument,\sineSimple,

    \scale,Scale.minor,

    \degree,
    Pseq(
        [0,1,2,3,4,5,6,7],
        inf
    ),

    \octave,5,

    \dur,0.25

).play;
)

//////////////////////////////////////////////////
// CHORDS
//////////////////////////////////////////////////

// A single degree:
//
// 0
//
// returns one note.
//
// An array:
//
// [0,2,4]
//
// returns multiple notes.

//////////////////////////////////////////////////
// TRIADS
//////////////////////////////////////////////////

(
Pbind(

    \instrument,\sineSimple,

    \scale,Scale.major,

    \degree,

    Pseq(

        [
            [0,2,4],
            [1,3,5],
            [2,4,6]
        ],

        inf

    ),

    \dur,0.5

).play;
)

//////////////////////////////////////////////////
// WHAT IS A TRIAD?
//////////////////////////////////////////////////

// Root
//
// Third
//
// Fifth

//////////////////////////////////////////////////
// SEVENTH CHORDS
//////////////////////////////////////////////////

(
Pbind(

    \instrument,\sineSimple,

    \scale,Scale.minor,

    \degree,

    Pseq(

        [
            [0,2,4,6],
            [3,5,7,9]
        ],

        inf

    ),

    \octave,5,

    \dur,0.5

).play;
)

//////////////////////////////////////////////////
// ARPEGGIOS
//////////////////////////////////////////////////

// Chord:
//
// all notes at once
//
// Arpeggio:
//
// notes played separately

//////////////////////////////////////////////////
// ARPEGGIO EXAMPLE
//////////////////////////////////////////////////

(
Pbind(

    \instrument,\sineSimple,

    \scale,Scale.major,

    \degree,

    Pseq(
        [0,2,4,2],
        inf
    ),

    \octave,5,

    \dur,0.25

).play;
)

//////////////////////////////////////////////////
// COMPARISON
//////////////////////////////////////////////////

// Chord

(
Pbind(
    \instrument,\sineSimple,

    \scale,Scale.major,

    \degree,
    Pseq(
        [[0,2,4]],
        inf
    ),

    \dur,1

).play;
)

//////////////////////////////////////////////////
// Arpeggio

(
Pbind(
    \instrument,\sineSimple,

    \scale,Scale.major,

    \degree,
    Pseq(
        [0,2,4],
        inf
    ),

    \dur,0.25

).play;
)

//////////////////////////////////////////////////
// STRUM
//////////////////////////////////////////////////

// Strum delays notes inside
// a chord.

(
Pbind(

    \instrument,\sineSimple,

    \scale,Scale.major,

    \degree,
    Pseq(
        [[0,2,4]],
        inf
    ),

    \dur,1,

    \strum,0.08

).play;
)

//////////////////////////////////////////////////
// LISTEN
//////////////////////////////////////////////////

// Compare:
//
// chord
//
// versus
//
// strummed chord

//////////////////////////////////////////////////
// LEGATO
//////////////////////////////////////////////////

// Legato affects
// note overlap.

//////////////////////////////////////////////////
// STACCATO
//////////////////////////////////////////////////

(
Pbind(

    \instrument,\sineSimple,

    \scale,Scale.major,

    \degree,
    Pseq(
        [0,2,4,5],
        inf
    ),

    \dur,0.5,

    \legato,0.3

).play;
)

//////////////////////////////////////////////////
// RESULT
//////////////////////////////////////////////////

// Short notes.

//////////////////////////////////////////////////
// LEGATO
//////////////////////////////////////////////////

(
Pbind(

    \instrument,\sineSimple,

    \scale,Scale.major,

    \degree,
    Pseq(
        [0,2,4,5],
        inf
    ),

    \dur,0.5,

    \legato,1.5

).play;
)

//////////////////////////////////////////////////
// RESULT
//////////////////////////////////////////////////

// Overlapping notes.

//////////////////////////////////////////////////
// USEFUL PARAMETERS
//////////////////////////////////////////////////

// scale
//
// degree
//
// octave
//
// root
//
// dur
//
// legato
//
// strum

