//////////////////////////////////////////////////
// 05 - PBIND
//////////////////////////////////////////////////

// Synth(...) = one note
//
// Pbind(...) = many notes

//////////////////////////////////////////////////
// SIMPLE PBIND
//////////////////////////////////////////////////

(
p = Pbind(

    \instrument,\saw,

    \freq,220,

    \dur,1

).play;
)

p.stop;

//////////////////////////////////////////////////
// FREQUENCY SEQUENCE
//////////////////////////////////////////////////

(
p = Pbind(

    \instrument,\saw,

    \freq,
    Pseq(
        [100,200,400,800],
        inf
    ),

    \dur,1

).play;
)

//////////////////////////////////////////////////
// EXERCISE
//////////////////////////////////////////////////

// Make:
//
// low notes
// high notes
// alternating notes