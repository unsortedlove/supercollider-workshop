//////////////////////////////////////////////////
// 02 - CONTROLLING PARAMETERS
//////////////////////////////////////////////////

// Parameters let us change a SynthDef
// without rewriting it.

// Available parameters:
//
// freq
// lpf
// amp
// atk
// rel

//////////////////////////////////////////////////
// FREQUENCY
//////////////////////////////////////////////////

// Frequency controls pitch.

Synth(\saw,[\freq,100]);

Synth(\saw,[\freq,400]);

Synth(\saw,[\freq,1000]);

//////////////////////////////////////////////////
// FILTER
//////////////////////////////////////////////////

Synth(\saw,[
    \freq,220,
    \lpf,200
]);

Synth(\saw,[
    \freq,220,
    \lpf,12000
]);

//////////////////////////////////////////////////
// ATTACK + RELEASE
//////////////////////////////////////////////////

Synth(\saw,[
    \atk,0.001,
    \rel,0.1
]);

Synth(\saw,[
    \atk,1,
    \rel,4
]);

//////////////////////////////////////////////////
// EXERCISE
//////////////////////////////////////////////////

// Explore:
//
// freq
// lpf
// atk
// rel
//
// What changes?
//
// Pitch?
// Brightness?
// Duration?